{
  "name": "biztalk-orchestration-viewer",
  "displayName": "BizTalk Orchestration Viewer",
  "description": "View BizTalk orchestration artifacts as interactive diagrams in VS Code.",
  "version": "0.1.0",
  "publisher": "lambogenius",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "extension.cjs",
  "activationEvents": [],
  "categories": [
    "Visualization"
  ],
  "contributes": {
    "commands": [
      {
        "command": "biztalkOrchestrationViewer.open",
        "title": "BizTalk: Open Orchestration Viewer"
      }
    ]
  },
  "files": [
    "dist/**",
    "extension.cjs",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --pool=threads",
    "package:vsix": "npm run build && vsce package --out artifacts/biztalk-orchestration-viewer.vsix"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vscode/vsce": "^3.6.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
